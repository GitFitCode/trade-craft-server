# Feature Flags - Choose your providers
USE_POLYGON_FOR_DATA=false
USE_ALPACA_FOR_DATA=true
USE_TRADERSTATION_FOR_TRADING=false
USE_TRADIER_FOR_TRADING=true

# Options Trading Features
ENABLE_OPTIONS_TRADING=false
OPTIONS_ONLY_MODE=false

# Polygon.io Configuration (Market Data)
POLYGON_API_KEY=your_polygon_api_key_here
POLYGON_ACCESS_KEY_ID=your_polygon_access_key_id_here
POLYGON_SECRET_ACCESS_KEY=your_polygon_secret_access_key_here
POLYGON_S3_ENDPOINT=https://files.polygon.io
POLYGON_S3_BUCKET=flatfiles

# TraderStation Configuration (Trading)
TRADERSTATION_API_KEY=your_traderstation_api_key_here
TRADERSTATION_API_SECRET=your_traderstation_api_secret_here
TRADERSTATION_ACCOUNT_ID=your_traderstation_account_id_here
TRADERSTATION_BASE_URL=https://api.tradestation.com

# Alpaca Configuration (Original - Market Data & Trading)
ALPACA_ENABLE_LIVE_TRADING=false
ALPACA_PAPER_API_KEY=your_paper_api_key_here
ALPACA_PAPER_API_SECRET=your_paper_api_secret_here
ALPACA_LIVE_API_KEY=your_live_api_key_here
ALPACA_LIVE_API_SECRET=your_live_api_secret_here

# Tradier Configuration (Original - Trading)
TRADIER_ENABLE_LIVE_TRADING=false
TRADIER_PAPER_ACCOUNT_NUMBER=your_paper_account_number_here
TRADIER_PAPER_ACCESS_TOKEN=your_paper_access_token_here
TRADIER_LIVE_ACCOUNT_NUMBER=your_live_account_number_here
TRADIER_LIVE_ACCESS_TOKEN=your_live_access_token_here

# Application Configuration
CLIENT_URL=http://localhost:3000
SENTRY_DSN=your_sentry_dsn_here
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o
FED_API_KEY=your_fed_api_key_here
MONGODB_URL=mongodb://localhost:27017/trading
PORT=4000
HOST=127.0.0.1

